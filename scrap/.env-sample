# Telegram Bot Token
# Get from @BotFather in Telegram: /newbot → create bot → copy token
# Format: <bot_id>:<bot_secret> (e.g. 6186948996:AAESaHBK8TGiu8PyXD1CI354EQ3IdLyH9rs)
TELEGRAM_BOT_TOKEN="enter your telegram bot token"

# Telegram Chat ID (channel or user)
# For channels: add bot as admin, send a message, then visit
#   https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# and look for "chat":{"id":-100...} in the response.
# For private chat: message @userinfobot and use the returned User ID.
TELEGRAM_CHAT_ID="enter your chat id, like: -1002024351434 or @BharatKiSamachar"

# OpenAI API Key
# Get from https://platform.openai.com/api-keys → "Create new secret key"
# Ensure your account has credits (check https://platform.openai.com/account/billing)
# Error 429 insufficient_quota means you need to add funds.
OPENAI_API_KEY="enter your openai api key (starts with sk-)"

# Session Cookie from Business Standard
# 1. Open https://www.business-standard.com/ in your browser
# 2. Accept cookies if prompted
# 3. Open DevTools (F12) → Application tab → Cookies → www.business-standard.com
# 4. Find "_sid" cookie and copy its value
# Note: This cookie expires — if scraping fails, get a fresh one.
SID="enter _sid cookie value"
